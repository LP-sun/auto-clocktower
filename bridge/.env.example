# Copy to bridge/.env and edit locally. Never paste credentials into chat.
BOTC_PROVIDER=codex
BOTC_CODEX_HTTP=1
BOTC_PLAYER_MODEL=gpt-5.6-luna
BOTC_PLAYER_EFFORT=medium
BOTC_ST_MODEL=gpt-6-astra
BOTC_ST_EFFORT=high
# Uses official Codex app-server and existing ChatGPT subscription login.
# No API key is needed. A usage reset is never consumed automatically.
# Optional: BOTC_REPLAY_FROM=absolute/path/to/previous/run
BOTC_SEED=42
BOTC_MAX_CALLS=1000
BOTC_MAX_DAYS=20
# Some local servers do not implement response_format:
# BOTC_JSON_MODE=off
